# --- Base de datos (Neon) ---
# postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# --- App ---
APP_URL=http://localhost:3000
# Registro público abierto (true/false)
ALLOW_OPEN_REGISTRATION=true
# Verifica automáticamente el email (la cuenta creada por script ya nace verificada)
AUTO_VERIFY_EMAILS=true

# --- Google OAuth (opcional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- LLM ---
# Chat vía OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
# Modelo del agente que crea/mueve/borra notas (gratuito por defecto)
OPENROUTER_AGENT_MODEL=nvidia/nemotron-3.5-lightning:free
# Fallbacks separados por comas; si falta, se usa la cadena interna
OPENROUTER_AGENT_FALLBACKS=
# Embeddings vía Google Gemini
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536

# --- Adjuntos y backups ---
# Backblaze B2 (recomendado; bucket privado, URLs firmadas)
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=
# Alternativa: Vercel Blob
BLOB_READ_WRITE_TOKEN=
# Sin B2 ni Blob, adjuntos y backups se guardan en Postgres (límite 25 MB por ZIP).

# --- Cron (opcional) ---
# Si se define, /api/cron/backup exige Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=

# --- Cuotas ---
DAILY_TOKEN_QUOTA=50000

# --- Email (opcional, Resend) ---
RESEND_API_KEY=
EMAIL_FROM=GRANATE <no-reply@granate.local>

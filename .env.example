# --- Base de datos (Neon) ---
# postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# --- App ---
APP_URL=http://localhost:3000
# Uso personal: el registro público queda cerrado. Crea tu cuenta con `npm run user:create`.
ALLOW_OPEN_REGISTRATION=false
# Verifica automáticamente el email (la cuenta creada por script ya nace verificada)
AUTO_VERIFY_EMAILS=true

# --- Google OAuth (opcional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- LLM ---
# Chat vía OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
# Embeddings vía Google Gemini
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536

# --- Cuotas ---
DAILY_TOKEN_QUOTA=50000

# --- Email (opcional, Resend) ---
RESEND_API_KEY=
EMAIL_FROM=GRANATE <no-reply@granate.local>
